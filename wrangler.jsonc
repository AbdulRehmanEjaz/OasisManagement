{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "oasis-management",
	"compatibility_date": "2026-10-21",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/fetch-handler",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "oasis-management-db",
			"database_id": "770b2298-60df-42b6-ab20-d6fb8f403f69",
			"migrations_dir": "migrations",
		},
	],
	"images": {
		"binding": "IMAGES"
	},
	"limits": {
		"cpu_ms": 30000
	},
	"assets": {
		"directory": "dist/client",
		"html_handling": "none",
		"not_found_handling": "none",
		"binding": "ASSETS",
		"run_worker_first": [
			"/*",
			"!/_next/static/*",
			"!/*/_next/static/*"
		],
	},
}